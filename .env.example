# ---------------------------------------------------------------------------
# Google Ads API credentials — copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# 1) Developer Token — Google Ads UI → Tools & Settings → API Center
#    (visible only on your MCC manager account)
GOOGLE_ADS_DEVELOPER_TOKEN=

# 2) OAuth2 client (Cloud Console → APIs & Services → Credentials → Desktop app)
GOOGLE_ADS_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=

# 3) Refresh token — generate once with: ./run.sh auth   (then paste the result here)
GOOGLE_ADS_REFRESH_TOKEN=

# 4) Login customer ID = your MCC manager account ID WITHOUT dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# Optional: extra accounts/logins. Suffix any var with _<NAME> (uppercase) to
# define a named profile selectable via `--account <name>`. Example:
#   GOOGLE_ADS_REFRESH_TOKEN_CLIENTB=...
#   GOOGLE_ADS_LOGIN_CUSTOMER_ID_CLIENTB=...
# ---------------------------------------------------------------------------

# Daily operations cap (Basic Access = 15000). The CLI tracks usage locally and
# warns as you approach this. Lower it if you want a safety margin.
GOOGLE_ADS_DAILY_OP_CAP=15000
