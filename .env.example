# ---------------------------------------------------------------------------
# Google Ads API credentials — copy to `.env` and fill in. NEVER commit `.env`.
# Full walkthrough (Czech): README.md → Autentizace
# ---------------------------------------------------------------------------

# 1) Developer token — Google Ads manager (MCC) account → Tools → API Center.
#    New tokens get Explorer Access (2 880 ops/day on production accounts,
#    Keyword Planner blocked) or Test Account Access; apply for Basic Access
#    (15 000 ops/day) in the same place.
GOOGLE_ADS_DEVELOPER_TOKEN=

# 2) OAuth2 client (Cloud Console → APIs & Services → Credentials → Desktop app).
#    Set the OAuth consent screen to "In production" — in "Testing" mode the
#    refresh token expires after 7 days.
GOOGLE_ADS_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=

# 3) Refresh token — generated and written here by: ./run.sh auth
GOOGLE_ADS_REFRESH_TOKEN=

# 4) Login customer ID = your MCC manager account ID WITHOUT dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# Alternative to 2)+3): a SERVICE ACCOUNT (no browser flow, no 7-day expiry;
# ideal for automations). Create it in Cloud Console, download the JSON key,
# add the service-account e-mail as a user of your Google Ads / MCC account
# (Admin → Access and security) and point to the key file. Keep the key file
# OUTSIDE the repo or inside the gitignored `.secrets/` folder.
# GOOGLE_ADS_JSON_KEY_FILE_PATH=.secrets/service-account.json
# GOOGLE_ADS_IMPERSONATED_EMAIL=        # optional (Workspace domain-wide delegation)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Optional: extra accounts/logins. Suffix any var with _<NAME> (uppercase) to
# define a named profile selectable via `--account <name>`. Example:
#   GOOGLE_ADS_REFRESH_TOKEN_CLIENTB=...
#   GOOGLE_ADS_LOGIN_CUSTOMER_ID_CLIENTB=...
# ---------------------------------------------------------------------------

# Daily operations cap (Basic Access = 15000; Explorer Access = 2880). Google
# meters it over a sliding 24 h window; the CLI tracks usage locally and
# hard-stops before exceeding this. Lower it for a safety margin, raise it
# (e.g. 1000000) for Standard Access.
GOOGLE_ADS_DAILY_OP_CAP=15000
